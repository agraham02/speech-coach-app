{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_TOOLS": "1"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DEV_TOOLS": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
